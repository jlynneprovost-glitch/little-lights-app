# Copy to .env.local. Keep real credentials out of Git.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe test mode: create recurring monthly/yearly prices in your dashboard.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Explicit opt-in is required before a live Stripe key can charge anyone.
STRIPE_LIVE_MODE=false
# At least 12 characters; never NEXT_PUBLIC_.
ADMIN_PASSWORD=
# At least 32 random characters; changing it expires all admin sessions.
ADMIN_SESSION_SECRET=
